# ==============================================================================
# LabAttend Backend Environment Variables Example
# ==============================================================================
# Copy this file to .env or configure your environment accordingly.
# Do NOT commit actual secrets or production credentials to version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Supabase PostgreSQL Database (JDBC)
SPRING_DATASOURCE_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/<DB_NAME>?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password

# Flyway Migration Configuration
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# JWT Authentication
# Base64 or Hex encoded secret key with at least 256 bits (32 bytes) of entropy
JWT_SECRET=your_base64_encoded_hmac_sha256_secret_key_min_32_bytes_long
JWT_EXPIRATION_MS=86400000

# CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
