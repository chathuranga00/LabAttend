# ==============================================================================
# LabAttend Frontend Environment Variables Example
# ==============================================================================
# Copy this file to .env or .env.local in the frontend directory.
# All Vite variables must begin with VITE_ to be exposed to the client.
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Application Metadata
VITE_APP_NAME=LabAttend
