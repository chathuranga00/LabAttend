# ==============================================================================
# LabAttend Frontend - Production Environment Configuration Example
# ==============================================================================
# In Vercel or Netlify, configure these under Settings -> Environment Variables.
# All variables must be prefixed with VITE_ to be exposed to the client bundle.
# ==============================================================================

# Public HTTPS URL of the deployed Spring Boot Backend API (no trailing slash)
# Example: https://labattend-backend.onrender.com/api or https://api.labattend.ac.lk/api
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api

# Application Title & Branding
VITE_APP_NAME=LabAttend
