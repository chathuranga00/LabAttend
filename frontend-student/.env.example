# All Vite variables must begin with VITE_ to be exposed to client.

# Backend API Base URL (Proxy dev default: /api; Direct: http://localhost:8080/api)
VITE_API_BASE_URL=http://localhost:8080/api

# Application Metadata
VITE_APP_NAME="LabAttend Student"
